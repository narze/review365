GITHUB_TOKEN=
GITHUB_USER=narze

# GitHub OAuth App (Connect with GitHub). Create at https://github.com/settings/developers
# → OAuth Apps → New OAuth App (NOT "GitHub Apps" — those use client IDs starting with Iv).
# Authorization callback URL: {APP_ORIGIN}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Defaults to the request origin (or https://$VERCEL_URL on Vercel).
# APP_ORIGIN=http://localhost:5173
